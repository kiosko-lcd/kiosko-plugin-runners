{
  "name": "kiosko-plugin-runners",
  "version": "0.1.2",
  "description": "Your CI runners on a small USB LCD panel: whether the GitLab runner container is up, the jobs running now, how much disk its cache volumes take and how fast they grow, the free space left where Docker keeps them and when it runs out, and when the cleanup last ran; optionally runner status and pending jobs from the GitLab API, GitHub Actions self-hosted runners and the runner's Prometheus metrics.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly <info@kioskolcd.dev> (https://kioskolcd.dev)",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "widgets",
    "dev",
    "ci",
    "gitlab-runner",
    "github-actions",
    "self-hosted-runner",
    "docker",
    "podman",
    "cache",
    "disk-space",
    "prometheus"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-runners#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-runners.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-runners/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "runners",
    "sdk": "^0.2.0",
    "languages": [
      "en",
      "es",
      "de",
      "zh-Hant",
      "zh-Hans"
    ],
    "manifest": "./kiosko-manifest.json"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "files": [
    "dist",
    "docs",
    "kiosko-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kiosko/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@kiosko/core": "^0.2.11",
    "@kiosko/sdk": "^0.2.11",
    "@loksly/lcd-canvas-kit": "^0.2.0",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
